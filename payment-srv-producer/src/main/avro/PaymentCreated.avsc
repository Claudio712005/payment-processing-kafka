 {
  "type": "record",
  "name": "PaymentCreated",
  "namespace": "com.clau.payment.events",
  "doc": "Emitido quando um pagamento é criado no sistema (fonte da verdade: banco).",
  "fields": [
    {
      "name": "metadata",
      "doc": "Envelope — metadados presentes em todo evento de pagamento.",
      "type": {
        "type": "record",
        "name": "EventMetadata",
        "fields": [
          {
            "name": "eventId",
            "type": { "type": "string", "logicalType": "uuid" },
            "doc": "ID único do evento — usado pelo consumidor para deduplicar (idempotência)."
          },
          {
            "name": "eventType",
            "type": "string",
            "doc": "Discriminador. Ex: 'PaymentCreated'. Permite o BFF rotear sem desserializar o payload."
          },
          {
            "name": "aggregateId",
            "type": { "type": "string", "logicalType": "uuid" },
            "doc": "ID do pagamento. É a CHAVE Kafka → garante ordem por pagamento."
          },
          {
            "name": "occurredAt",
            "type": { "type": "long", "logicalType": "timestamp-millis" },
            "doc": "Quando o fato ocorreu no domínio (não quando foi publicado)."
          },
          {
            "name": "correlationId",
            "type": ["null", "string"],
            "default": null,
            "doc": "Rastreio distribuído — amarra este evento à requisição original que o originou."
          }
        ]
      }
    },
    {
      "name": "amount",
      "type": { "type": "bytes", "logicalType": "decimal", "precision": 19, "scale": 4 },
      "doc": "Valor do pagamento. decimal → BigDecimal no Kotlin. NUNCA usar double."
    },
    {
      "name": "currency",
      "type": { "type": "enum", "name": "Currency", "symbols": ["BRL", "USD", "EUR"] },
      "doc": "Moeda ISO-4217. Enum trava valores inválidos no contrato."
    },
    {
      "name": "payerId",
      "type": { "type": "string", "logicalType": "uuid" },
      "doc": "Quem paga."
    },
    {
      "name": "payeeId",
      "type": { "type": "string", "logicalType": "uuid" },
      "doc": "Quem recebe."
    },
    {
      "name": "method",
      "type": { "type": "enum", "name": "PaymentMethod", "symbols": ["PIX", "CREDIT_CARD", "BOLETO"] },
      "doc": "Meio de pagamento."
    }
  ]
}
